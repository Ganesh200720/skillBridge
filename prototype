        renderAll();
      });
      document.getElementById("co-kind")?.addEventListener("change", (e)=>{
        document.getElementById("co-durationWrap").style.display = e.target.value==="internship" ? "block":"none";
      });
      document.getElementById("postOppBtn")?.addEventListener("click", ()=>{
        const title = document.getElementById("co-title").value.trim();
        if(!title){ alert("Please enter a title."); return; }
        const kind = document.getElementById("co-kind").value;
        const skills = document.getElementById("co-skills").value.split(",").map(s=>s.trim()).filter(Boolean);
        const opp = {
          id: idc++, kind, company: companyProfile.name||"Your Company", title,
          stipend: document.getElementById("co-pay").value.trim(),
          duration: kind==="internship" ? document.getElementById("co-duration").value.trim() : null,
          skills: skills.length?skills:["Communication"],
          desc: document.getElementById("co-desc").value.trim(),
          applicants: candidatePool.slice(0,3).map(c=>({username:c.username, status:"Applied"}))
        };
        opportunities[kind].push(opp);
        ["co-title","co-pay","co-duration","co-skills","co-desc"].forEach(id=>document.getElementById(id).value="");
        navTo("myopportunities");
      });
      document.getElementById("fcSkillFilter")?.addEventListener("change", renderFindCandidates);
      document.getElementById("crSkill")?.addEventListener("change", renderRanking);
    }
    if(session.role==="academician"){
      document.getElementById("acadPostBtn")?.addEventListener("click", ()=>{
        const t = document.getElementById("af-title").value.trim();
        if(!t) return;
        const box = document.getElementById("acadOfferedList");
        const d = document.createElement("div"); d.className="listing";
        d.innerHTML = `<div class="lt"><h4>${t}</h4><p class="org">Posted to collaboration board</p></div><div class="side"><span class="tag have">Posted</span></div>`;
        box.appendChild(d);
        document.getElementById("af-title").value="";
      });
    }
  }
 
  // ===================================================================
  // RENDER: STUDENT
  // ===================================================================
  function renderAll(){
    if(!session) return;
    if(session.role==="student"){
      renderDashboard(); renderProfilePanel(); renderOppList("internship"); renderOppList("placement");
      renderAnalysis(); renderCareer(); renderPortfolio();
    } else if(session.role==="company"){
      renderCompanyDashboard(); renderMyOpportunities(); renderFindCandidates(); renderRanking();
    }
  }
 
  function renderDashboard(){
    const invBox = document.getElementById("dashInvites");
    if(invBox){
      if(!student.invitations.length){ invBox.innerHTML = '<div class="empty">No company invitations yet. Verify more skills to get noticed.</div>'; }
      else invBox.innerHTML = student.invitations.map(inv=>`
        <div class="callout"><div><h4>${inv.company} wants to talk to you</h4><p>${inv.title} · ${inv.kind}</p></div>
        <span class="tag brass">Reach out via portal</span></div>`).join("");
    }
    const appBox = document.getElementById("dashApps");
    if(appBox){
      if(!student.applications.length){ appBox.innerHTML = '<div class="empty">You haven\'t applied to anything yet — check Internships or Placements.</div>'; }
      else appBox.innerHTML = student.applications.map(a=>{
        const stepMap = {Applied:1, Shortlisted:2, Interview:3, Requested:3};
        const steps = stepMap[a.status]||1;
        return `<div class="prog-card">
          <div class="pt"><h4>${a.title}</h4><p>${a.company} · ${a.kind}</p>
            <div class="prog-steps">${[1,2,3].map(i=>`<span class="pstep ${i<=steps?'on':''}"></span>`).join("")}</div>
          </div>
          <span class="status-badge status-${a.status}">${a.status}</span>
        </div>`;
      }).join("");
    }
  }
 
  function renderProfilePanel(){
    const bars = document.getElementById("profileSkillBars");
    if(bars){
      const entries = Object.entries(student.skills);
      bars.innerHTML = entries.length ? entries.map(([s,v])=>`
        <div class="barrow"><span class="bl">${s}</span><div class="bartrack"><div class="barfill" style="width:${v}%"></div></div><span class="barval">${v}%</span></div>`).join("")
        : '<p style="font-size:13px; color:var(--text-mute);">No verified skills yet — verify one below.</p>';
    }
    const grid = document.getElementById("skillCardGrid");
    if(grid){
      grid.innerHTML = SKILLS.map(s=>{
        const verified = student.skills[s.k] !== undefined;
        const pct = verified ? student.skills[s.k] : 0;
        return `<div class="skillcard">
          <div class="sic">${s.icon}</div><h4>${s.k}</h4>
          ${verified ? `<div class="ring" style="--p:${pct}"><div class="inner">${pct}%</div></div><span class="tag have">Verified</span>`
                     : `<button class="btn btn-outline btn-sm" data-verify="${s.k}">Verify skill</button>`}
        </div>`;
      }).join("");
      grid.querySelectorAll("[data-verify]").forEach(b=>b.addEventListener("click", ()=>openQuiz(b.dataset.verify)));
    }
  }
 
  function scoreMatch(reqSkills){
    if(!reqSkills.length) return 0;
    let total = 0;
    reqSkills.forEach(s=>{ total += student.skills[s] !== undefined ? student.skills[s] : 0; });
    return Math.round(total/reqSkills.length);
  }
 
  function renderOppList(kind, matchMode){
    const listId = kind==="internship" ? "internshipList" : "placementList";
    const searchId = kind==="internship" ? "intSearch" : "plcSearch";
    const box = document.getElementById(listId);
    if(!box) return;
    const q = (document.getElementById(searchId)?.value || "").toLowerCase();
    let items = opportunities[kind].filter(o => !q || o.title.toLowerCase().includes(q));
    if(matchMode) items = items.slice().sort((a,b)=>scoreMatch(b.skills)-scoreMatch(a.skills));
    if(!items.length){ box.innerHTML = '<div class="empty">No opportunities match your search.</div>'; return; }
    box.innerHTML = items.map(o=>{
      const score = scoreMatch(o.skills);
      const cls = score>=70?"":score>=40?"mid":"low";
      const applied = student.applications.find(a=>a.oppId===o.id && a.kind===kind);
      return `<div class="listing" data-opp="${o.id}" data-kind="${kind}">
        <div class="lt">
          <h4>${o.title}</h4>
          <p class="org">${o.company}${o.duration?" · "+o.duration:""}${o.stipend?" · "+o.stipend:""}</p>
          <div class="skills">${o.skills.map(s=>`<span class="tag ${student.skills[s]!==undefined?'have':'gap'}">${s}</span>`).join("")}</div>
        </div>
        <div class="side">
          <span class="match ${cls}">${score}% skill match</span>
          <button class="btn btn-sm ${applied?'btn-ghost':'btn-brass'}" ${applied?'disabled':''} data-apply="${o.id}" data-kind="${kind}">${applied?'Applied ✓':'Apply now'}</button>
        </div>
      </div>`;
    }).join("");
    box.querySelectorAll(".listing").forEach(l=>{
      l.addEventListener("click", (e)=>{
        if(e.target.closest("[data-apply]")) return;
        openOppDetail(parseInt(l.dataset.opp), l.dataset.kind);
      });
    });
    box.querySelectorAll("[data-apply]").forEach(btn=>{
      btn.addEventListener("click", (e)=>{
        e.stopPropagation();
        applyToOpp(parseInt(btn.dataset.kind==="internship"?btn.dataset.apply:btn.dataset.apply), btn.dataset.kind);
      });
    });
  }
  function applyToOpp(oppId, kind){
    const o = opportunities[kind].find(x=>x.id===oppId);
    if(!o) return;
    if(student.applications.find(a=>a.oppId===oppId && a.kind===kind)) return;
    student.applications.push({oppId, kind, company:o.company, title:o.title, status:"Applied"});
    o.applicants.push({username:student.username, status:"Applied"});
    renderOppList(kind); renderDashboard();
  }
  function openOppDetail(oppId, kind){
    const o = opportunities[kind].find(x=>x.id===oppId);
    const score = scoreMatch(o.skills);
    document.getElementById("detailBody").innerHTML = `
      <h2>${o.title}</h2>
      <p class="sub">${o.company}${o.duration?" · "+o.duration:""}${o.stipend?" · "+o.stipend:""}</p>
      <div class="skills" style="display:flex; flex-wrap:wrap; gap:6px; margin:14px 0;">${o.skills.map(s=>`<span class="tag ${student.skills[s]!==undefined?'have':'gap'}">${s}</span>`).join("")}</div>
      <p style="font-size:13.8px; color:var(--text-mute);">${o.desc||"No additional description provided."}</p>
      <p style="font-family:var(--mono); font-size:13px; color:var(--teal); margin-top:14px;">Your skill match: ${score}%</p>
    `;
    document.getElementById("detailOverlay").classList.remove("hidden");
  }
 
  // ---- quiz ----
  let quizState = null;
  function openQuiz(skill){
    const qs = QBANK[skill] || [];
    quizState = {skill, idx:0, correct:0, picked:null};
    document.getElementById("quizTitle").textContent = skill+" — skill assessment";
    renderQuizQuestion();
    document.getElementById("quizOverlay").classList.remove("hidden");
  }
  document.getElementById("quizClose").addEventListener("click", ()=>document.getElementById("quizOverlay").classList.add("hidden"));
  function renderQuizQuestion(){
    const qs = QBANK[quizState.skill];
    const body = document.getElementById("quizBody");
    if(quizState.idx >= qs.length){
      const pct = Math.round((quizState.correct/qs.length)*100);
      student.skills[quizState.skill] = pct;
      body.innerHTML = `<div class="resultbig"><div class="rv">${pct}%</div><div class="rl">Score for ${quizState.skill} — added to your profile</div></div>
        <button class="btn btn-brass btn-block" id="quizDoneBtn">Done</button>`;
      document.getElementById("quizDoneBtn").addEventListener("click", ()=>{
        document.getElementById("quizOverlay").classList.add("hidden");
        renderAll();
      });
      return;
    }
    const [q, opts, correctIdx] = qs[quizState.idx];
    body.innerHTML = `<div class="qprog">Question ${quizState.idx+1} of ${qs.length}</div>
      <div class="qtext">${q}</div>
      ${opts.map((o,i)=>`<button class="qopt" data-i="${i}">${o}</button>`).join("")}`;
    body.querySelectorAll(".qopt").forEach(btn=>{
      btn.addEventListener("click", ()=>{
        const i = parseInt(btn.dataset.i);
        body.querySelectorAll(".qopt").forEach(b=>b.disabled=true);
        btn.classList.add(i===correctIdx?"correct":"wrong");
        if(i===correctIdx) quizState.correct++;
        else body.querySelector(`[data-i="${correctIdx}"]`).classList.add("correct");
        setTimeout(()=>{ quizState.idx++; renderQuizQuestion(); }, 700);
      });
    });
  }
 
  // ---- analysis ----
  function renderAnalysis(){
    const box = document.getElementById("roleDemandList");
    if(!box) return;
    box.innerHTML = CAREER_ROLES.slice().sort((a,b)=>b.demand-a.demand).map(r=>`
      <div class="listing" style="cursor:default;">
        <div class="lt"><h4>${r.role}</h4><div class="skills">${r.skills.map(s=>`<span class="tag ${student.skills[s]!==undefined?'have':'gap'}">${s}</span>`).join("")}</div></div>
        <div class="side"><span class="match">${r.demand}% industry demand</span></div>
      </div>`).join("");
    const tagBox = document.getElementById("skillDemandTags");
    tagBox.innerHTML = Object.entries(DEMAND).filter(([s])=>student.skills[s]===undefined).sort((a,b)=>b[1]-a[1]).slice(0,6)
      .map(([s,d])=>`<span class="tag gap">${s} · ${d}% in demand</span>`).join("") || '<span style="font-size:13px; color:var(--text-mute);">You\'ve verified all catalog skills 🎉</span>';
  }
 
  // ---- career guidance ----
  function renderCareer(){
    const strong = document.getElementById("careerStrong");
    const gap = document.getElementById("careerGap");
    if(!strong) return;
    const entries = Object.entries(student.skills);
    strong.innerHTML = entries.filter(([,v])=>v>=60).map(([s,v])=>`<span class="tag have">${s} · ${v}%</span>`).join("") || '<span style="font-size:13px; color:var(--text-mute);">Verify skills to see strengths.</span>';
    gap.innerHTML = entries.filter(([,v])=>v<60).map(([s,v])=>`<span class="tag gap">${s} · ${v}%</span>`).join("") || '<span style="font-size:13px; color:var(--text-mute);">No weak verified skills — nice.</span>';
 
    const standoutBox = document.getElementById("careerStandout");
    const interestMatch = CAREER_ROLES.filter(r=>student.interests.some(i=>r.role.toLowerCase().includes(i.toLowerCase())));
    const target = interestMatch[0] || CAREER_ROLES.slice().sort((a,b)=>b.demand-a.demand)[0];
    const missing = target.skills.filter(s=>student.skills[s]===undefined);
    standoutBox.innerHTML = missing.length ? missing.map(s=>`<span class="tag gap">${s}</span>`).join(" ") : '<span class="tag have">You already cover this role\'s core skills</span>';
    document.getElementById("careerSuggestion").textContent = `Based on ${student.interests.length? "your stated interests":"current demand"}, ${target.role} looks like a strong fit (${target.demand}% industry demand). Verifying ${missing.length? missing.join(", "):"your current skills further"} would strengthen this path.`;
  }
 
  function renderPortfolio(){
    const box = document.getElementById("portfolioSkills");
    if(!box) return;
    const entries = Object.entries(student.skills);
    box.innerHTML = entries.length ? entries.map(([s,v])=>`<span class="tag have">${s} · ${v}%</span>`).join("") : '<span style="font-size:13px; color:var(--text-mute);">No verified skills yet.</span>';
  }
 
  // ---- mock interview ----
  const MI_QUESTIONS = {
    default:["Tell me about a project you're proud of.","How do you approach debugging a tricky issue?","Describe a time you worked in a team under a deadline."],
  };
  function startMockInterview(){
    const q = document.getElementById("miSearch").value.trim() || "General";
    const bank = QBANK[q] ? QBANK[q].map(x=>x[0]) : MI_QUESTIONS.default;
    const area = document.getElementById("miArea");
    area.innerHTML = `<div class="chatbox" id="chatbox"></div>
      <div style="display:flex; gap:8px;"><input type="text" id="miAnswer" placeholder="Type your answer..." style="margin:0;"><button class="btn btn-brass btn-sm" id="miSend">Send</button></div>`;
    let i = 0;
    const chat = document.getElementById("chatbox");
    function bot(msg){ chat.innerHTML += `<div class="msg bot"><div class="bubble">${msg}</div></div>`; chat.scrollTop = chat.scrollHeight; }
    function me(msg){ chat.innerHTML += `<div class="msg me"><div class="bubble">${msg}</div></div>`; chat.scrollTop = chat.scrollHeight; }
    bot(`Mock interview for <strong>${q}</strong> — let's begin.`);
    bot(bank[0]);
    document.getElementById("miSend").addEventListener("click", ()=>{
      const val = document.getElementById("miAnswer").value.trim();
      if(!val) return;
      me(val);
      document.getElementById("miAnswer").value="";
      i++;
      if(i < bank.length){ setTimeout(()=>bot(bank[i]), 400); }
      else { setTimeout(()=>bot("That's the end of this round — nice work. Review your answers for clarity and structure (Situation → Task → Action → Result)."), 400); }
    });
  }
 
  // ===================================================================
  // RENDER: COMPANY
  // ===================================================================
  function myCompanyOpps(){
    return [...opportunities.internship, ...opportunities.placement].filter(o=>o.company===companyProfile.name);
  }
  function renderCompanyDashboard(){
    const list = document.getElementById("companyDashList");
    if(!list) return;
    const mine = myCompanyOpps();
    document.getElementById("dashApplicantTotal").textContent = mine.reduce((a,o)=>a+o.applicants.length,0);
    if(!mine.length){ list.innerHTML = '<div class="empty">You haven\'t posted anything yet — try Create Opportunity.</div>'; return; }
    list.innerHTML = mine.map(o=>`
      <div class="listing" data-opp="${o.id}" data-kind="${o.kind}">
        <div class="lt"><h4>${o.title}</h4><p class="org">${o.kind}${o.duration?" · "+o.duration:""}${o.stipend?" · "+o.stipend:""}</p>
        <div class="skills">${o.skills.map(s=>`<span class="tag">${s}</span>`).join("")}</div></div>
        <div class="side"><span class="match">${o.applicants.length} applicants</span><span class="tag brass">Click for ranked profiles</span></div>
      </div>`).join("");
    list.querySelectorAll(".listing").forEach(l=>l.addEventListener("click", ()=>openCandidatesModal(parseInt(l.dataset.opp), l.dataset.kind)));
  }
  function renderMyOpportunities(){
    const list = document.getElementById("myOppList");
    if(!list) return;
    const mine = myCompanyOpps();
    if(!mine.length){ list.innerHTML = '<div class="empty">No postings yet.</div>'; return; }
    list.innerHTML = mine.map(o=>`
      <div class="listing" data-opp="${o.id}" data-kind="${o.kind}">
        <div class="lt"><h4>${o.title}</h4><p class="org">${o.kind}${o.duration?" · "+o.duration:""}${o.stipend?" · "+o.stipend:""}</p>
        <div class="skills">${o.skills.map(s=>`<span class="tag">${s}</span>`).join("")}</div></div>
        <div class="side"><span class="match">${o.applicants.length} applicants</span></div>
      </div>`).join("");
    list.querySelectorAll(".listing").forEach(l=>l.addEventListener("click", ()=>openCandidatesModal(parseInt(l.dataset.opp), l.dataset.kind)));
  }
  function candidateScore(cand, reqSkills){
    if(!reqSkills.length) return 0;
    let total=0; reqSkills.forEach(s=>{ total += (cand.skills[s]!==undefined?cand.skills[s]:0); });
    return Math.round(total/reqSkills.length);
  }
  function openCandidatesModal(oppId, kind){
    const o = opportunities[kind].find(x=>x.id===oppId);
    const pool = candidatePool.filter(c=>o.applicants.some(a=>a.username===c.username));
    const ranked = pool.map(c=>({...c, score:candidateScore(c,o.skills)})).sort((a,b)=>b.score-a.score);
    document.getElementById("detailBody").innerHTML = `
      <h2>${o.title}</h2><p class="sub">${ranked.length} applicant(s), ranked by skill match to: ${o.skills.join(", ")}</p>
      ${ranked.map(c=>{
        const app = o.applicants.find(a=>a.username===c.username);
        return `<div class="listing" style="cursor:default;">
          <div class="lt"><h4>${c.name} <span style="font-family:var(--mono); font-size:11.5px; color:var(--text-mute);">${c.username}</span></h4>
          <p class="org">${c.email} · ${c.phone}</p>
          <div class="skills">${Object.entries(c.skills).map(([s,v])=>`<span class="tag ${o.skills.includes(s)?'have':''}">${s} ${v}%</span>`).join("")}</div></div>
          <div class="side"><span class="match">${c.score}% match</span>
          <button class="btn btn-sm ${app.status==='Requested'?'btn-ghost':'btn-brass'}" data-req="${c.username}" data-opp="${o.id}" data-kind="${o.kind}" ${app.status==='Requested'?'disabled':''}>${app.status==='Requested'?'Requested ✓':'Request candidate'}</button></div>
        </div>`;
      }).join("") || '<div class="empty">No applicants yet.</div>'}
    `;
    document.getElementById("detailBody").querySelectorAll("[data-req]").forEach(btn=>{
      btn.addEventListener("click", ()=>{
        const uname = btn.dataset.req;
        const app = o.applicants.find(a=>a.username===uname);
        app.status = "Requested";
        if(uname === student.username){
          student.invitations.push({oppId:o.id, kind:o.kind, company:o.company, title:o.title});
          const sa = student.applications.find(a=>a.oppId===o.id && a.kind===o.kind);
          if(sa) sa.status = "Requested";
        }
        openCandidatesModal(oppId, kind);
        renderAll();
      });
    });
    document.getElementById("detailOverlay").classList.remove("hidden");
  }
  function renderFindCandidates(){
    const box = document.getElementById("findCandidatesList");
    if(!box) return;
    const filter = document.getElementById("fcSkillFilter")?.value || "";
    let pool = candidatePool.slice();
    if(student.username) pool = pool.concat([{username:student.username, name:student.name, email:student.email, phone:student.phone, skills:student.skills}]);
    if(filter) pool = pool.filter(c=>c.skills[filter]!==undefined);
    box.innerHTML = pool.map(c=>`
      <div class="listing" style="cursor:default;">
        <div class="lt"><h4>${c.name||"Unnamed"} <span style="font-family:var(--mono); font-size:11.5px; color:var(--text-mute);">${c.username}</span></h4>
        <p class="org">${c.email||"—"} ${c.phone?"· "+c.phone:""}</p>
        <div class="skills">${Object.entries(c.skills).map(([s,v])=>`<span class="tag have">${s} ${v}%</span>`).join("") || '<span style="font-size:12px; color:var(--text-mute);">No verified skills yet</span>'}</div></div>
      </div>`).join("") || '<div class="empty">No candidates match this filter.</div>';
  }
  function renderRanking(){
    const box = document.getElementById("rankingList");
    if(!box) return;
    const skill = document.getElementById("crSkill")?.value || SKILLS[0].k;
    let pool = candidatePool.slice();
    if(student.username) pool = pool.concat([{username:student.username, name:student.name, skills:student.skills}]);
    const ranked = pool.filter(c=>c.skills[skill]!==undefined).sort((a,b)=>b.skills[skill]-a.skills[skill]);
    box.innerHTML = ranked.length ? ranked.map((c,i)=>`
      <div class="listing" style="cursor:default;">
        <div class="lt"><h4>#${i+1} — ${c.name} <span style="font-family:var(--mono); font-size:11.5px; color:var(--text-mute);">${c.username}</span></h4></div>
        <div class="side"><span class="match">${c.skills[skill]}% in ${skill}</span></div>
      </div>`).join("") : `<div class="empty">No candidates have verified ${skill} yet.</div>`;
  }
 
  // ===================================================================
  // shared modal close
  // ===================================================================
  document.getElementById("detailClose").addEventListener("click", ()=>document.getElementById("detailOverlay").classList.add("hidden"));
  [document.getElementById("authOverlay"), document.getElementById("quizOverlay"), document.getElementById("detailOverlay")].forEach(ov=>{
    ov.addEventListener("click", (e)=>{ if(e.target===ov) ov.classList.add("hidden"); });
  });
 
})();
</script>
</body>
</html>
 
