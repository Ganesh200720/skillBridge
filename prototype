
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bridge — Academia · Industry Collaboration Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#12203D; --ink-mid:#3E4E72; --paper:#F6F3EC; --paper-dim:#EDE8DB; --card:#FFFFFF;
    --brass:#B8823A; --brass-soft:#E8D3AE; --teal:#24685A; --teal-soft:#D7E9E3;
    --coral:#B24A2E; --coral-soft:#F3DED4; --line:#D9D2C0; --text:#20242E; --text-mute:#5B6273;
    --radius:14px; --display:'Fraunces',serif; --body:'IBM Plex Sans',sans-serif; --mono:'IBM Plex Mono',monospace;
    --sidebar-w:230px;
  }
  *{box-sizing:border-box;}
  body{margin:0; background:var(--paper); color:var(--text); font-family:var(--body); line-height:1.5; -webkit-font-smoothing:antialiased;}
  a{color:inherit;} button{font-family:var(--body); cursor:pointer;}
  :focus-visible{outline:2.5px solid var(--brass); outline-offset:2px;}
  h1,h2,h3,h4{font-family:var(--display); color:var(--ink); margin:0;}
  .hidden{display:none !important;}
 
  /* ---------- landing ---------- */
  header.top{background:var(--ink); color:var(--paper);}
  .top-inner{max-width:1200px; margin:0 auto; padding:16px 24px; display:flex; align-items:center; justify-content:space-between;}
  .brand{display:flex; align-items:center; gap:10px; font-family:var(--display); font-weight:600; font-size:20px;}
  .brand .mark{width:30px;height:30px; border-radius:8px; background:linear-gradient(135deg,var(--brass),var(--teal)); display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:13px; color:#fff; font-weight:700;}
  #landing main{max-width:1200px; margin:0 auto; padding:60px 24px 90px;}
  .lhero{text-align:center; max-width:640px; margin:0 auto 46px;}
  .eyebrow{font-family:var(--mono); font-size:12.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--teal); font-weight:500; margin-bottom:14px;}
  .lhero h1{font-size:44px; line-height:1.08; margin-bottom:16px; letter-spacing:-.5px;}
  .lhero p{color:var(--text-mute); font-size:16px; margin:0;}
  .role-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
  .role-card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:26px 22px; text-align:left; transition:.18s;}
  .role-card:hover{border-color:var(--brass); transform:translateY(-3px); box-shadow:0 12px 28px -16px rgba(18,32,61,.35);}
  .role-card .ric{font-size:26px; margin-bottom:12px;}
  .role-card h3{font-size:18px; margin-bottom:6px;}
  .role-card p{font-size:12.8px; color:var(--text-mute); margin:0 0 16px;}
  .role-card .go{font-family:var(--mono); font-size:12px; color:var(--brass); font-weight:600;}
  @media (max-width:880px){.role-grid{grid-template-columns:1fr 1fr;} .lhero h1{font-size:32px;}}
 
  /* ---------- modal ---------- */
  .overlay{position:fixed; inset:0; background:rgba(18,26,45,.55); display:flex; align-items:center; justify-content:center; z-index:100; padding:20px;}
  .modal{background:var(--card); border-radius:var(--radius); max-width:420px; width:100%; padding:30px 28px; position:relative; max-height:90vh; overflow:auto;}
  .modal.wide{max-width:640px;}
  .modal .close{position:absolute; top:14px; right:16px; background:none; border:none; font-size:20px; color:var(--text-mute); line-height:1;}
  .modal h2{font-size:22px; margin-bottom:4px;}
  .modal .sub{color:var(--text-mute); font-size:13px; margin-bottom:20px;}
  .authtoggle{display:flex; gap:6px; background:var(--paper-dim); border-radius:10px; padding:4px; margin-bottom:20px;}
  .authtoggle button{flex:1; background:none; border:none; padding:9px; border-radius:8px; font-size:13.5px; font-weight:600; color:var(--text-mute);}
  .authtoggle button.active{background:var(--card); color:var(--ink); box-shadow:0 1px 4px rgba(0,0,0,.08);}
 
  /* ---------- forms ---------- */
  label.flabel{display:block; font-size:12px; font-weight:600; color:var(--ink-mid); margin:0 0 6px; text-transform:uppercase; letter-spacing:.03em;}
  input[type=text],input[type=email],input[type=password],input[type=tel],input[type=number],select,textarea{
    width:100%; padding:10px 12px; border:1.5px solid var(--line); border-radius:9px; font-family:var(--body);
    font-size:14px; background:var(--paper); color:var(--text); margin-bottom:15px;
  }
  textarea{resize:vertical; min-height:64px;}
  input:focus,select:focus,textarea:focus{border-color:var(--brass); outline:none; background:#fff;}
  .form-row2{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .btn{border:none; border-radius:10px; padding:12px 20px; font-weight:600; font-size:14px; display:inline-flex; align-items:center; gap:8px; transition:.15s;}
  .btn-primary{background:var(--ink); color:var(--paper);}
  .btn-primary:hover{background:#0A1526;}
  .btn-brass{background:var(--brass); color:#221704;}
  .btn-brass:hover{background:#a3742f;}
  .btn-outline{background:transparent; border:1.5px solid var(--ink); color:var(--ink);}
  .btn-outline:hover{background:var(--ink); color:var(--paper);}
  .btn-ghost{background:transparent; border:1px solid var(--line); color:var(--text);}
  .btn-ghost:hover{border-color:var(--ink);}
  .btn-sm{padding:7px 13px; font-size:12.5px; border-radius:8px;}
  .btn-block{width:100%; justify-content:center;}
  .btn:disabled{opacity:.5; cursor:default;}
 
  /* ---------- app shell ---------- */
  #appShell{display:flex; min-height:100vh;}
  .sidebar{width:var(--sidebar-w); background:var(--ink); color:var(--paper); flex-shrink:0; display:flex; flex-direction:column; position:sticky; top:0; height:100vh;}
  .sidebar .sbrand{padding:22px 20px; font-family:var(--display); font-weight:600; font-size:17px; border-bottom:1px solid rgba(246,243,236,.12); display:flex; align-items:center; gap:9px;}
  .sidebar .sbrand .mark{width:26px;height:26px; border-radius:7px; background:linear-gradient(135deg,var(--brass),var(--teal)); display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:11px; color:#fff; font-weight:700;}
  .sidenav{padding:14px 10px; flex:1; overflow-y:auto;}
  .sidenav .navlabel{font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:#8592AE; padding:14px 12px 8px;}
  .sidenav button{
    width:100%; text-align:left; background:none; border:none; color:#C9D0E0; padding:10px 12px; border-radius:9px;
    font-size:13.8px; font-weight:500; display:flex; align-items:center; gap:10px; margin-bottom:2px; transition:.15s;
  }
  .sidenav button:hover{background:rgba(246,243,236,.08); color:#fff;}
  .sidenav button.active{background:var(--brass); color:#221704; font-weight:600;}
  .sidefoot{padding:14px 18px; border-top:1px solid rgba(246,243,236,.12); font-size:12.5px;}
  .sidefoot .who{font-weight:600; margin-bottom:2px;}
  .sidefoot .role{color:#8592AE; font-family:var(--mono); font-size:11px; margin-bottom:10px;}
  .sidefoot button{background:none; border:1px solid rgba(246,243,236,.25); color:var(--paper); padding:7px 12px; border-radius:8px; font-size:12px; width:100%;}
  .sidefoot button:hover{background:rgba(246,243,236,.1);}
 
  .content{flex:1; min-width:0; padding:30px 36px 80px;}
  .cwrap{max-width:1080px;}
  .phead{margin-bottom:24px;}
  .phead h2{font-size:26px; margin-bottom:4px;}
  .phead .sub{color:var(--text-mute); font-size:13.5px;}
 
  .panel{display:none;}
  .panel.active{display:block; animation:fade .3s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}
 
  .stat-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:26px;}
  .stat-card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:17px 19px;}
  .stat-card .sv{font-family:var(--display); font-size:28px; font-weight:600;}
  .stat-card .sl{font-size:12px; color:var(--text-mute); margin-top:2px;}
 
  .card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px;}
  .card h3{font-size:17px; margin-bottom:14px;}
  .card + .card{margin-top:16px;}
  .grid-2{display:grid; grid-template-columns:1.25fr 1fr; gap:18px;}
  @media(max-width:1000px){.grid-2{grid-template-columns:1fr;} .stat-grid{grid-template-columns:1fr 1fr;}}
 
  .tag{display:inline-flex; align-items:center; gap:5px; font-family:var(--mono); font-size:11px; background:var(--paper-dim); border:1px solid var(--line); padding:4px 9px; border-radius:999px; color:var(--ink-mid);}
  .tag.gap{background:var(--coral-soft); border-color:#e3bda9; color:var(--coral);}
  .tag.have{background:var(--teal-soft); border-color:#bcdcd2; color:var(--teal);}
  .tag.brass{background:var(--brass-soft); border-color:var(--brass); color:#6b4a15;}
 
  /* progress card (dashboard) */
  .prog-card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; margin-bottom:12px; display:flex; justify-content:space-between; gap:16px; align-items:center; flex-wrap:wrap;}
  .prog-card .pt h4{font-size:15px; margin-bottom:3px;}
  .prog-card .pt p{margin:0; font-size:12.5px; color:var(--text-mute);}
  .prog-steps{display:flex; gap:5px; margin-top:8px;}
  .pstep{width:34px; height:6px; border-radius:4px; background:var(--paper-dim);}
  .pstep.on{background:var(--teal);}
  .callout{background:var(--brass-soft); border:1px solid var(--brass); border-radius:var(--radius); padding:16px 20px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center; gap:14px; flex-wrap:wrap;}
  .callout h4{font-size:14.5px; margin-bottom:3px; color:#5c3f11;}
  .callout p{margin:0; font-size:12.5px; color:#6b4a15;}
 
  /* skill cards */
  .skillcard-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px;}
  .skillcard{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px; text-align:center;}
  .skillcard .sic{font-size:26px; margin-bottom:8px;}
  .skillcard h4{font-size:14.5px; margin-bottom:10px;}
  .ring{width:56px; height:56px; border-radius:50%; margin:0 auto 10px; display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:13px; font-weight:700; color:var(--teal); background:conic-gradient(var(--teal) calc(var(--p)*1%), var(--paper-dim) 0);}
  .ring .inner{width:44px; height:44px; border-radius:50%; background:var(--card); display:flex; align-items:center; justify-content:center;}
 
  /* listings */
  .listing{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; margin-bottom:12px; display:flex; justify-content:space-between; gap:16px; align-items:flex-start; flex-wrap:wrap; cursor:pointer; transition:.15s;}
  .listing:hover{border-color:var(--brass);}
  .listing .lt{flex:1; min-width:230px;}
  .listing h4{font-size:16px; margin-bottom:3px;}
  .listing .org{font-size:12.8px; color:var(--text-mute); margin:0 0 9px;}
  .listing .skills{display:flex; gap:6px; flex-wrap:wrap;}
  .listing .side{display:flex; flex-direction:column; align-items:flex-end; gap:9px; min-width:130px;}
  .match{font-family:var(--mono); font-size:11.5px; color:var(--teal); font-weight:600;}
  .match.mid{color:var(--brass);} .match.low{color:var(--coral);}
  .toolbar{display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap; align-items:center;}
  .toolbar input[type=text]{margin:0; max-width:260px;}
  .empty{padding:36px 18px; text-align:center; color:var(--text-mute); border:1.5px dashed var(--line); border-radius:var(--radius); font-size:13px;}
 
  .status-badge{font-family:var(--mono); font-size:10.5px; padding:3px 9px; border-radius:999px; font-weight:600;}
  .status-Applied{background:#E4E9F5; color:var(--ink-mid);}
  .status-Shortlisted{background:var(--teal-soft); color:var(--teal);}
  .status-Interview{background:var(--brass-soft); color:#6b4a15;}
  .status-Requested{background:var(--coral-soft); color:var(--coral);}
 
  .barlist{display:flex; flex-direction:column; gap:11px;}
  .barrow{display:grid; grid-template-columns:120px 1fr 38px; align-items:center; gap:10px; font-size:12.5px;}
  .barrow .bl{color:var(--text-mute);}
  .bartrack{background:var(--paper-dim); border-radius:6px; height:9px; overflow:hidden;}
  .barfill{height:100%; border-radius:6px; background:linear-gradient(90deg,var(--teal),#3f9482);}
  .barfill.gapfill{background:linear-gradient(90deg,var(--coral),#c96849);}
  .barval{font-family:var(--mono); color:var(--ink-mid); text-align:right;}
 
  /* quiz */
  .qprog{font-family:var(--mono); font-size:11.5px; color:var(--text-mute); margin-bottom:14px;}
  .qtext{font-size:16px; font-weight:600; margin-bottom:16px;}
  .qopt{display:block; width:100%; text-align:left; padding:12px 14px; border:1.5px solid var(--line); border-radius:10px; background:var(--paper); margin-bottom:9px; font-size:13.8px;}
  .qopt:hover{border-color:var(--brass);}
  .qopt.picked{border-color:var(--ink); background:var(--paper-dim); font-weight:600;}
  .qopt.correct{border-color:var(--teal); background:var(--teal-soft);}
  .qopt.wrong{border-color:var(--coral); background:var(--coral-soft);}
  .resultbig{text-align:center; padding:20px 0;}
  .resultbig .rv{font-family:var(--display); font-size:52px; font-weight:700; color:var(--teal);}
  .resultbig .rl{color:var(--text-mute); font-size:13.5px; margin-top:4px;}
 
  /* mock interview chat */
  .chatbox{border:1px solid var(--line); border-radius:var(--radius); background:var(--card); padding:16px; max-height:360px; overflow-y:auto; margin-bottom:14px;}
  .msg{margin-bottom:14px; max-width:80%;}
  .msg.bot{margin-right:auto;}
  .msg.me{margin-left:auto; text-align:right;}
  .msg .bubble{display:inline-block; padding:10px 14px; border-radius:12px; font-size:13.8px; text-align:left;}
  .msg.bot .bubble{background:var(--paper-dim); color:var(--text);}
  .msg.me .bubble{background:var(--ink); color:var(--paper);}
 
  footer{border-top:1px solid var(--line); padding:20px 24px; text-align:center; color:var(--text-mute); font-size:12px;}
</style>
</head>
<body>
 
<!-- ================= LANDING ================= -->
<div id="landing">
  <header class="top"><div class="top-inner"><div class="brand"><span class="mark">B</span>Bridge</div></div></header>
  <main>
    <div class="lhero">
      <div class="eyebrow">One platform, three worlds</div>
      <h1>Close the gap between the classroom and the job.</h1>
      <p>Choose your role to get started — you'll be asked to sign in or create an account.</p>
    </div>
    <div class="role-grid">
      <button class="role-card" data-role="student">
        <div class="ric">🎓</div><h3>Student</h3>
        <p>Get skills verified, match to internships &amp; placements, prep for interviews.</p>
        <div class="go">Continue as student →</div>
      </button>
      <button class="role-card" data-role="company">
        <div class="ric">🏭</div><h3>Company</h3>
        <p>Post opportunities and get candidates ranked by verified skill match.</p>
        <div class="go">Continue as company →</div>
      </button>
      <button class="role-card" data-role="academician">
        <div class="ric">📚</div><h3>Academician</h3>
        <p>Find FDPs, consultancy work and live industry projects.</p>
        <div class="go">Continue as academician →</div>
      </button>
      <button class="role-card" data-role="institution">
        <div class="ric">🏛️</div><h3>Institution</h3>
        <p>Monitor skill development and placement readiness college-wide.</p>
        <div class="go">Continue as institution →</div>
      </button>
    </div>
  </main>
  <footer>Bridge — a prototype Academia–Industry Collaboration Portal. All data shown is illustrative.</footer>
</div>
 
<!-- ================= AUTH MODAL ================= -->
<div class="overlay hidden" id="authOverlay">
  <div class="modal">
    <button class="close" id="authClose">×</button>
    <h2 id="authTitle">Student access</h2>
    <p class="sub" id="authSub">Sign in or create an account to continue.</p>
    <div class="authtoggle">
      <button class="active" id="toggleLogin">Log in</button>
      <button id="toggleSignup">Sign up</button>
    </div>
    <form id="authForm">
      <div id="signupOnly" class="hidden">
        <label class="flabel">Full name</label>
        <input type="text" id="au-name" placeholder="e.g. Priya Nair">
      </div>
      <label class="flabel">Email</label>
      <input type="email" id="au-email" placeholder="you@example.com" required>
      <label class="flabel">Password</label>
      <input type="password" id="au-pass" placeholder="••••••••" required>
      <button class="btn btn-brass btn-block" type="submit" id="authSubmit">Log in</button>
    </form>
  </div>
</div>
 
<!-- ================= APP SHELL ================= -->
<div id="appShell" class="hidden">
  <div class="sidebar">
    <div class="sbrand"><span class="mark">B</span>Bridge</div>
    <div class="sidenav" id="sidenav"></div>
    <div class="sidefoot">
      <div class="who" id="sfWho">—</div>
      <div class="role" id="sfRole">—</div>
      <button id="logoutBtn">Log out</button>
    </div>
  </div>
  <div class="content"><div class="cwrap" id="panels"></div></div>
</div>
 
<!-- ================= QUIZ MODAL ================= -->
<div class="overlay hidden" id="quizOverlay">
  <div class="modal wide">
    <button class="close" id="quizClose">×</button>
    <h2 id="quizTitle">Skill assessment</h2>
    <div id="quizBody"></div>
  </div>
</div>
 
<!-- ================= DETAIL / CANDIDATES MODAL ================= -->
<div class="overlay hidden" id="detailOverlay">
  <div class="modal wide">
    <button class="close" id="detailClose">×</button>
    <div id="detailBody"></div>
  </div>
</div>
 
